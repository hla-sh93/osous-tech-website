<?xml version="1.0"?>
<ruleset name="Osous">
	<description>The WordPress Coding Standards, as WordPress publishes them, applied to the theme.</description>

	<!--
		Only the theme is a WordPress product. The static reference pages, the migration
		scripts and the tools under _tools/ are how the theme was built and checked, and
		they are not shipped.
	-->
	<file>theme</file>
	<exclude-pattern>theme/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- The full WordPress ruleset: Core, Docs, Extra and the security sniffs. -->
	<rule ref="WordPress"/>

	<!-- What the theme promises in style.css, so the sniffs check against the same floor. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Every string a person sees goes through the one text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="osous"/>
			</property>
		</properties>
	</rule>

	<!--
		The theme's own output helpers. Each one escapes everything it emits: esc_url()
		and esc_attr() on every attribute in osous_attrs(), wp_kses() in osous_inline(),
		esc_html() on every line in osous_address(); each returns markup that is safe to
		print. Declaring them here is the mechanism WPCS provides for exactly this, and it
		is what lets the sniff keep checking every echo instead of every echo carrying an
		ignore comment nobody re-reads.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="osous_class_attr"/>
				<element value="osous_srcset"/>
				<element value="osous_inline"/>
				<element value="osous_address"/>
				<element value="osous_copyright"/>
				<element value="osous_aria_current"/>
				<element value="osous_post_thumb"/>
			</property>
		</properties>
	</rule>

	<!-- Everything global carries the theme's name, so it can never collide with a plugin. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="osous"/>
				<element value="OSOUS"/>
			</property>
		</properties>
	</rule>
</ruleset>
