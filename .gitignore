# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Python (the scripts under _tools/)
__pycache__/
*.py[cod]

# Build scratch — the page builder writes its <main> here before splicing
_svc_main.html

# Local WordPress scratch — database dumps and one-off migration scripts
/_migration/*
!/_migration/README.txt

# The editor build is committed on purpose: the theme ships as a zip, and a zip that
# needs `npm run build` before it works is not a theme.
/node_modules/

# Handoff package — rebuilt on demand by `./_tools/env.sh package`, plus whatever
# Explorer leaves behind when the folder is zipped up to send.
/dist/
/dist.zip
