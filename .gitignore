# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Python (the scripts under _tools/)
__pycache__/
*.py[cod]

# Build scratch — the page builder writes its <main> here before splicing
_svc_main.html

# Local WordPress scratch — database dumps and one-off migration scripts
/_migration/*
!/_migration/README.txt

# Block editor build output and dependencies
/node_modules/
/theme/build/

# Handoff package — rebuilt on demand by `./_tools/env.sh package`
/dist/
