{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/container",
	"title": "Container",
	"category": "osous",
	"icon": "table-row-after",
	"description": "The box inside a section that holds its content at the design's width. It can carry a colour, a border, a shadow or a picture.",
	"keywords": [ "panel", "box", "band" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section" ],
	"attributes": {
		"width": { "type": "string", "default": "default" },
		"fit": { "type": "boolean", "default": false },
		"surface": { "type": "string", "default": "" },
		"border": { "type": "boolean", "default": false },
		"elevation": { "type": "boolean", "default": false },
		"mobilePadding": { "type": "boolean", "default": false },
		"carousel": { "type": "boolean", "default": false },
		"fullHeight": { "type": "boolean", "default": false },
		"backdrop": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:../../includes/layout/container.php"
}
