{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/text",
	"title": "Text",
	"category": "osous",
	"icon": "text",
	"description": "A paragraph or a label, in one of the design's text styles.",
	"keywords": [ "paragraph", "label" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section", "osous/pinned-list" ],
	"attributes": {
		"content": { "type": "string", "default": "" },
		"tagName": { "type": "string", "default": "p" },
		"style": { "type": "string", "default": "p" },
		"tone": { "type": "string", "default": "" },
		"weight": { "type": "string", "default": "" },
		"align": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
