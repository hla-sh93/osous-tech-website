{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/heading",
	"title": "Heading",
	"category": "osous",
	"icon": "heading",
	"description": "A heading, in one of the design's sizes and colours.",
	"keywords": [ "title" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section", "osous/pinned-list" ],
	"attributes": {
		"content": { "type": "string", "default": "" },
		"level": { "type": "integer", "default": 2 },
		"size": { "type": "string", "default": "" },
		"tone": { "type": "string", "default": "" },
		"weight": { "type": "string", "default": "" },
		"align": { "type": "string", "default": "" },
		"place": { "type": "string", "default": "" },
		"span": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:../../includes/elements/heading.php"
}
