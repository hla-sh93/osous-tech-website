{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/numbered-card",
	"title": "Purple card",
	"category": "osous",
	"icon": "index-card",
	"description": "A purple card: a number or a small icon if you want one, a title, a line of text or a few paragraphs, and perhaps a button.",
	"keywords": [ "numbered", "step", "feature" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section" ],
	"allowedBlocks": [ "core/paragraph", "core/list", "core/heading" ],
	"attributes": {
		"number": { "type": "string", "default": "" },
		"icon": { "type": "object", "default": {} },
		"fill": { "type": "boolean", "default": true },
		"title": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "" },
		"buttonUrl": { "type": "string", "default": "#" },
		"outline": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"reusable": false
	},
	"render": "file:../../includes/parts/numbered-card.php"
}
