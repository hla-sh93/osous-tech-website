{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/feature-card",
	"title": "Feature",
	"category": "osous",
	"icon": "slides",
	"description": "One feature of a split section: a title and text on one side, a picture on the other.",
	"textdomain": "osous",
	"parent": [ "osous/split-section" ],
	"attributes": {
		"title": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"image": { "type": "object", "default": {} },
		"mediaFirst": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
