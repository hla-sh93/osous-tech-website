{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/button",
	"title": "Button",
	"category": "osous",
	"icon": "button",
	"description": "A link drawn as one of the design's buttons.",
	"keywords": [ "link", "cta" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section", "osous/pinned-list" ],
	"attributes": {
		"text": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "#" },
		"style": { "type": "string", "default": "primary" },
		"narrow": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
