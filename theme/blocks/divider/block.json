{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/divider",
	"title": "Divider",
	"category": "osous",
	"icon": "minus",
	"description": "A rule: a thin grey line, or the design's short gradient stroke.",
	"keywords": [ "rule", "line", "separator" ],
	"textdomain": "osous",
	"attributes": {
		"style": { "type": "string", "default": "neutral" },
		"narrow": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
