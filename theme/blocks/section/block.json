{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/section",
	"version": "0.1.0",
	"title": "Section",
	"category": "design",
	"icon": "align-wide",
	"description": "One section of a page. Its words and pictures are edited in the sidebar; its shape belongs to the theme.",
	"keywords": [
		"osous",
		"section",
		"row"
	],
	"textdomain": "osous",
	"supports": {
		"html": false,
		"reusable": false,
		"customClassName": false,
		"className": false,
		"anchor": false,
		"inserter": false
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"nodes": {
			"type": "array",
			"default": []
		}
	},
	"editorScript": "file:../../build/section.js"
}
