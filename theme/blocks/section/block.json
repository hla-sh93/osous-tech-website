{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/section",
	"title": "Section",
	"category": "osous",
	"icon": "align-wide",
	"description": "A band across the page. Every page is a list of these; each holds a container, and the container holds the content.",
	"keywords": [ "band", "row" ],
	"textdomain": "osous",
	"attributes": {
		"spacing": { "type": "string", "default": "default" },
		"background": { "type": "string", "default": "" },
		"height": { "type": "string", "default": "" },
		"joinBelow": { "type": "boolean", "default": false }
	},
	"allowedBlocks": [ "osous/container", "osous/group" ],
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:../../includes/layout/section.php"
}
