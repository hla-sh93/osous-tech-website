{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/pinned-item",
	"title": "Pinned list item",
	"category": "osous",
	"icon": "editor-ul",
	"description": "One item of a pinned list: a short title and a line of text.",
	"textdomain": "osous",
	"parent": [ "osous/pinned-items" ],
	"attributes": {
		"title": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"titleStyle": { "type": "string", "default": "medium" },
		"textStyle": { "type": "string", "default": "normal" }
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"reusable": false
	},
	"render": "file:../../includes/parts/pinned-item.php"
}
