{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/hero",
	"title": "Hero",
	"category": "osous",
	"icon": "cover-image",
	"description": "The home page opening: a full-height photograph, the headline, and a marquee of partner marks across the bottom.",
	"keywords": [ "home", "marquee", "banner" ],
	"textdomain": "osous",
	"allowedBlocks": [ "osous/image" ],
	"attributes": {
		"title": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"picture": { "type": "string", "default": "" },
		"pictureShade": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"reusable": false,
		"multiple": false
	},
	"render": "file:../../includes/sections/hero.php"
}
