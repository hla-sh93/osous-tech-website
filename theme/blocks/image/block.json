{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/image",
	"title": "Image",
	"category": "osous",
	"icon": "format-image",
	"description": "A picture or an icon, at one of the design's sizes.",
	"keywords": [ "picture", "icon", "photo" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section", "osous/hero" ],
	"attributes": {
		"src": { "type": "string", "default": "" },
		"alt": { "type": "string", "default": "" },
		"srcset": { "type": "string", "default": "" },
		"sizes": { "type": "string", "default": "" },
		"priority": { "type": "boolean", "default": false },
		"size": { "type": "string", "default": "" },
		"fit": { "type": "string", "default": "" },
		"rounded": { "type": "boolean", "default": false },
		"place": { "type": "string", "default": "" },
		"span": { "type": "string", "default": "" },
		"tabletRow": { "type": "string", "default": "" },
		"spaceBelow": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"customClassName": true,
		"className": false,
		"reusable": false
	},
	"render": "file:../../includes/elements/image.php"
}
