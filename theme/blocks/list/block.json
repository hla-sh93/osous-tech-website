{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/list",
	"title": "List",
	"category": "osous",
	"icon": "editor-ul",
	"description": "A list of points, each with a bullet or a tick.",
	"keywords": [ "bullets", "ticks", "points" ],
	"textdomain": "osous",
	"ancestor": [ "osous/section" ],
	"allowedBlocks": [ "osous/list-item" ],
	"attributes": {
		"style": { "type": "string", "default": "bullet" },
		"tone": { "type": "string", "default": "" }
	},
	"providesContext": {
		"osous/listStyle": "style"
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
