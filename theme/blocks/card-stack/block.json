{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "osous/card-stack",
	"title": "Card stack",
	"category": "osous",
	"icon": "images-alt",
	"description": "A heading beside a stack of glass cards that fan out and change as the page scrolls.",
	"keywords": [ "why us", "scroll", "stack" ],
	"textdomain": "osous",
	"allowedBlocks": [ "osous/photo-card" ],
	"attributes": {
		"title": { "type": "string", "default": "" },
		"cardWrapper": { "type": "string", "default": "card-overlapping-item" }
	},
	"providesContext": {
		"osous/cardWrapper": "cardWrapper"
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
