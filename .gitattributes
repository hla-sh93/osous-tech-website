# Keep line endings stable across Windows and the Linux host the theme will run on.
* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.php   text eol=lf
*.py    text eol=lf
*.svg   text eol=lf

# Generated from the static pages by _tools/gen_fixtures.py.
theme/fixtures/*.php linguist-generated=true

*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
